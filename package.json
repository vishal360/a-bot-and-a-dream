{
  "name": "a-bot-and-a-dream",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run src/server.ts",
    "build": "bun x vite build",
    "start": "bun run src/server.ts",
    "test": "bun test ./tests",
    "typecheck": "bun x tsc --noEmit",
    "check": "bun run typecheck && bun run test && bun run build",
    "test:e2e": "bun run build && bun node_modules/@playwright/test/cli.js test"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}